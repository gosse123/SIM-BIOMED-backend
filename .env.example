# SIM-BIOMED — variables d'environnement
# Copier vers .env pour le développement local (.env n'est jamais commité).
# En production, ces valeurs vivent dans le gestionnaire de secrets de la
# plateforme (Render, Railway, …) et non dans un fichier.

# ---------------------------------------------------------------------------
# Développement local (config.settings.development, docker compose)
# ---------------------------------------------------------------------------
POSTGRES_DB=simbiomed
POSTGRES_USER=simbiomed
POSTGRES_PASSWORD=simbiomed_dev
DJANGO_SECRET_KEY=dev-secret-key-change-in-prod

# ---------------------------------------------------------------------------
# Production (config.settings.production)
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change_me_in_production
# Hôte(s) public(s) de l'API, séparés par des virgules.
# Sur Render, RENDER_EXTERNAL_HOSTNAME est ajouté automatiquement si le
# sous-domaine reçoit un suffixe : pas besoin de le deviner ici.
ALLOWED_HOSTS=simbiomed-api.onrender.com
# Origine de l'interface : alimente CORS_ALLOWED_ORIGINS et CSRF_TRUSTED_ORIGINS
# (config/settings/origins.py). Indispensable — le proxy nginx envoie
# Host = api alors que le navigateur vient du front : sans elle, tout POST
# du navigateur renvoie 403 « Vérification CSRF a échoué ».
FRONTEND_ORIGIN=https://simbiomed-frontend.onrender.com
# Origines CORS supplémentaires (au-delà de FRONTEND_ORIGIN), virgule séparées
CORS_ALLOWED_ORIGINS=
# Origine propre de l'API (repli hors Render)
CSRF_TRUSTED_ORIGINS=https://simbiomed-api.onrender.com

# Base externe (Supabase, Railway, …) — un seul URL suffit.
# Supabase : mode pooler SESSION (jamais Transaction, qui casse les prepared
# statements de Django) + ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Alternatives à DATABASE_URL (mutuellement exclusives) :
# DB_HOST=HOST
# DB_PORT=5432
# POSTGRES_DB=simbiomed
# POSTGRES_USER=simbiomed
# POSTGRES_PASSWORD=change_me_in_production

# Broker Redis (Celery) : le même service pour worker et beat.
# Sur Render, renseigné automatiquement par le Key Value du blueprint.
REDIS_URL=redis://:PASSWORD@HOST:6379/0

# Redirection HTTPS : à passer à false uniquement derrière un proxy
# qui ne transmet pas X-Forwarded-Proto (sinon boucle de redirection).
SECURE_SSL_REDIRECT=true

# Journalisation : DEBUG, INFO, WARNING, …
LOG_LEVEL=INFO

# Gunicorn
PORT=8000
WEB_CONCURRENCY=2

# Démarrage du conteneur (false sur les services worker/beat)
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true
